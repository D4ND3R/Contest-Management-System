# Settings of the compose stack. ./setup.sh copies this file to .env and
# fills in the secrets (once); keep .env private.

# Release to run (a version such as 1.2.0, or latest) and where the images are.
CMS_VERSION=latest
CMS_IMAGE=ghcr.io/d4nd3r/contest-management-system

# Sites: domain names get HTTPS (setup.sh --domain cms.example.org writes
# cms.example.org, ranking.cms.example.org and admin.cms.example.org);
# http://:PORT is plain HTTP.
CONTEST_SITE=http://:80
RANKING_SITE=http://:8080
ADMIN_SITE=http://:8081
# Secure cookies: true with HTTPS.
COOKIE_SECURE=false
# Public address of the ranking (links in the admin panel), e.g. https://ranking.cms.example.org
RANKING_URL=

# CPUs: the web servers, PostgreSQL and Valkey on WEB_CPUS; the sandbox alone
# on JUDGE_CPUS (a list, one judging slot per CPU). 2 vCPU: 0 and 1.
WEB_CPUS=0
JUDGE_CPUS=1

# PostgreSQL memory (about 1/8 and 1/2 of the RAM).
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=2GB

# Secrets (generated by setup.sh).
DB_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
PUSH_TOKEN=
